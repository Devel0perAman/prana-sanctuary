# Copy to .env and fill in. Never commit .env. Never put the secret in client code.
PORT=8787
NODE_ENV=production
# Behind Nginx / Render / Railway etc. set to 1 so rate-limiting sees the real visitor IP
TRUST_PROXY=0

# ---- Razorpay (https://dashboard.razorpay.com → Settings → API Keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
# Dashboard → Settings → Webhooks → URL https://YOUR-DOMAIN/api/payments/webhook, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=replace_me

# ---- WhatsApp floating button (country code + number, digits only) ----
WHATSAPP_NUMBER=919876543210
WHATSAPP_MESSAGE=Namaste! I would like to know more about PRĀNA Sanctuary.

# ---- Contact form email (optional — messages are ALWAYS saved to server/data/messages.jsonl) ----
CONTACT_TO=sanctuary@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Optional: use your own hero video URL (CDN). Default: /media/hero.webm + /media/hero.mp4 ----
HERO_VIDEO_URL=
# Only needed if the site is served from a different origin than the API
CLIENT_ORIGIN=
